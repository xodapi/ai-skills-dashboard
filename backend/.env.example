# Database
DATABASE_URL=postgresql+asyncpg://ai_skills_user:changeme@localhost:5432/ai_skills
POSTGRES_USER=ai_skills_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_skills

# Redis
REDIS_URL=redis://localhost:6379/0

# API Keys
HH_API_KEY=your_hh_api_key_here
LINKEDIN_COOKIES=your_linkedin_cookies_here
STACKOVERFLOW_KEY=your_stackoverflow_key_here

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated GitHub usernames allowed to bootstrap the admin role on OAuth login.
ADMIN_USERNAMES=

# CORS
CORS_ORIGINS=http://localhost:3000,https://ai-skills.syntog.ru

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Monitoring
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=INFO

# Scraping
SCRAPE_INTERVAL_MINUTES=15
MAX_VACANCIES_PER_REQUEST=100
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# ML
ML_MODEL_PATH=ml/models/
PREDICTION_HORIZON_DAYS=90

# Deployment
ENVIRONMENT=development
DEBUG=True
